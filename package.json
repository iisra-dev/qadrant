{
	"name": "qadrant",
	"private": true,
	"version": "1.4.2",
	"type": "module",
	"scripts": {
		"dev": "node scripts/prepare-ort.mjs && node scripts/licenses.mjs && vite dev",
		"build": "node scripts/prepare-ort.mjs && node scripts/licenses.mjs && vite build",
		"preview": "sirv build --single --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "TZ=Europe/Madrid vitest run",
		"test:watch": "TZ=Europe/Madrid vitest",
		"test:e2e": "playwright test --project=chromium",
		"icons": "pwa-assets-generator",
		"deploy:pages": "pnpm build && wrangler pages deploy build --project-name qadrant",
		"bench:prepare": "node tools/model-bench/prepare.mjs",
		"bench:build": "pnpm bench:prepare && vite build --config tools/model-bench/vite.config.ts",
		"bench:preview": "vite preview --config tools/model-bench/vite.config.ts",
		"bench:deploy": "pnpm bench:build && wrangler pages deploy tools/model-bench/dist --project-name qadrant-bench --branch main",
		"model:prepare": "node scripts/chunk-model.mjs --model tools/embed-eval/model --out static/models --calibration tools/embed-eval/calibration.json",
		"test:e2e:webkit": "scripts/e2e-webkit.sh",
		"site:build": "node scripts/build-site.mjs",
		"site:preview": "pnpm site:build && sirv site/dist --dev --port 4174",
		"site:deploy": "pnpm site:build && wrangler pages deploy site/dist --project-name qadrant-site --branch main"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.4",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.1.1",
		"sirv-cli": "^3.0.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.3",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.147.0"
	},
	"packageManager": "pnpm@10.34.6",
	"dependencies": {
		"@fontsource/bricolage-grotesque": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@huggingface/transformers": "^4.3.0",
		"chrono-node": "^2.10.2",
		"dexie": "^4.4.6",
		"onnxruntime-web": "^1.30.0"
	}
}
