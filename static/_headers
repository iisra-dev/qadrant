# Cloudflare Pages headers (docs/02-arquitectura.md, "Cabeceras").
# The rest of the CSP is a <meta> tag generated by SvelteKit (kit.csp in svelte.config.js).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), geolocation=(), microphone=(self)

/service-worker.js
  Cache-Control: no-cache

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Home screen and manifest icons: under COEP, iOS may fetch them from outside the
# page, so they say any origin can read them (they are public anyway).
/apple-touch-icon*
  Cross-Origin-Resource-Policy: cross-origin

/pwa-*
  Cross-Origin-Resource-Policy: cross-origin

/maskable-icon-*
  Cross-Origin-Resource-Policy: cross-origin

/manifest.webmanifest
  Cross-Origin-Resource-Policy: cross-origin

/licenses.txt
  Content-Type: text/plain; charset=utf-8
